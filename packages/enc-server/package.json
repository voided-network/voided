{
  "name": "@voideddev/enc-server",
  "version": "1.0.0",
  "description": "Server-side hashing, compression, encryption, and v3 monolith artifact library backed by Rust",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "require": {
        "types": "./dist/native/index.d.cts",
        "default": "./dist/native/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build:native": "node scripts/build-native-release.js",
    "build:all": "npm run build:native && npm run build",
    "postinstall": "node scripts/postinstall-verify.js",
    "test": "node src/__tests__/run-all.mjs",
    "test:native": "npm run verify:release:current",
    "test:integration": "node tests/integration.test.mjs",
    "test:all": "npm run test:native && npm run test:integration && npm run test",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts src/native/index.ts src/crypto-backend.ts --format esm,cjs --dts --watch",
    "verify:release": "node scripts/verify-release.js",
    "verify:release:current": "node scripts/verify-release.js --current-platform",
    "verify:reproducible-native:current": "node scripts/verify-reproducible-native.js",
    "verify:reproducible-native:windows": "node scripts/verify-reproducible-native.js --target=win32-x64-msvc",
    "verify:source": "node ../../scripts/verify-release-source.js --package packages/enc-server --tag-prefix enc-server-v --allow-untagged",
    "prepare:prebuilds": "node scripts/prepare-prebuilds.js",
    "smoke:package": "node scripts/package-smoke.js",
    "smoke:package:current": "node scripts/package-smoke.js --current-platform",
    "prepack": "npm run build && npm run verify:release && npm run prepare:prebuilds",
    "prepublishOnly": "node ../../scripts/verify-release-source.js --package packages/enc-server --tag-prefix enc-server-v && npm run typecheck && npm run build:all && npm run verify:release && npm run prepare:prebuilds && npm run smoke:package"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "fast-check": "^3.13.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "prebuilds",
    "scripts/postinstall-verify.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "encryption",
    "compression",
    "fused-shell",
    "security",
    "rust",
    "native"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "https://github.com/voided-network/voided"
}

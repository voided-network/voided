{
  "name": "@voideddev/e2ee-client",
  "version": "0.4.4",
  "description": "Browser-based E2EE client library for keys, crypto, v3 monolith artifacts, compression, and local storage adapters.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./wasm": {
      "import": {
        "types": "./dist/wasm/loader.d.ts",
        "default": "./dist/wasm/loader.js"
      },
      "require": {
        "types": "./dist/wasm/loader.d.cts",
        "default": "./dist/wasm/loader.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto-backend.d.ts",
        "default": "./dist/crypto-backend.js"
      },
      "require": {
        "types": "./dist/crypto-backend.d.cts",
        "default": "./dist/crypto-backend.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/wasm/loader.ts src/crypto-backend.ts --format esm,cjs --dts --clean --treeshake --no-splitting --platform browser --target es2020 && npm run verify:loader-dist",
    "build:wasm": "node scripts/build-wasm-release.js",
    "build:all": "npm run build:wasm && npm run build",
    "test": "jest --testPathIgnorePatterns=gb-scale --testPathIgnorePatterns=benchmark-all",
    "test:integration": "node tests/integration.test.mjs",
    "test:wasm": "node --experimental-wasm-modules wasm/test-wasm.mjs",
    "test:memory": "node --max-old-space-size=8192 ./node_modules/.bin/jest",
    "test:benchmark": "jest --testNamePattern='benchmark' --maxWorkers=1 --testTimeout=6000 --verbose",
    "test:all": "npm run test:integration && npm run test",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts src/wasm/loader.ts src/crypto-backend.ts --format esm,cjs --dts --watch",
    "verify:release": "node scripts/verify-release.js",
    "verify:reproducible-wasm": "node scripts/verify-reproducible-wasm.js",
    "verify:loader-dist": "node scripts/verify-wasm-loader-dist.js",
    "smoke:package": "node scripts/package-smoke.js",
    "prepack": "npm run build && npm run prepare:wasm",
    "verify:source": "node ../../scripts/verify-release-source.js --package packages/e2ee-client --tag-prefix e2ee-client-v --allow-untagged",
    "prepublishOnly": "node ../../scripts/verify-release-source.js --package packages/e2ee-client --tag-prefix e2ee-client-v && npm run typecheck && npm run verify:reproducible-wasm && npm run build && npm run prepare:wasm && npm run smoke:package",
    "prepare:wasm": "node scripts/prepare-wasm-package.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.10",
    "fast-check": "^3.13.1",
    "fflate": "^0.8.2",
    "jest": "^29.0.0",
    "qrcode": "^1.5.3",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "wasm",
    "examples/key-export-import-example.html",
    "examples/customizable-key-ui-example.html",
    "examples/simple-key-ui.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "e2ee",
    "encryption",
    "browser",
    "client-side",
    "fused-shell",
    "privacy",
    "rust",
    "wasm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voided-network/voided.git"
  }
}

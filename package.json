{
  "name": "@voideddev/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "description": "voideddev - Monolith-first data protection with native Rust and WASM bindings",
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:rust": "node scripts/build-all.js --rust",
    "build:npm": "node scripts/build-all.js --npm",
    "build:node": "node scripts/build-all.js --node",
    "build:wasm": "node scripts/build-all.js --wasm",
    "build:cross:linux": "node scripts/build-cross-platform.js --linux",
    "build:cross:mac": "node scripts/build-cross-platform.js --mac",
    "build:cross:windows": "node scripts/build-cross-platform.js --windows",
    "test": "npm run test --workspaces --if-present",
    "test:enc-server": "cd packages/enc-server && npm test",
    "test:e2ee-client": "cd packages/e2ee-client && npm test",
    "test:release-provenance-inputs": "node scripts/test-release-provenance-inputs.js",
    "test:rust:performance": "cargo test --manifest-path crates/Cargo.toml -p voided-core --test stress_tests throughput --release -- --ignored --test-threads=1",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "licenses:generate": "node scripts/generate-third-party-notices.js",
    "release:verify:source": "node scripts/verify-release-source.js --all --allow-untagged",
    "lint": "eslint --max-warnings=0 \"packages/*/src/**/*.{js,ts,mjs,cjs}\" \"packages/*/scripts/**/*.{js,ts,mjs,cjs}\" \"packages/*/tests/**/*.{js,ts,mjs,cjs}\" \"scripts/**/*.{js,ts,mjs,cjs}\" \"examples/**/*.{js,ts,mjs,cjs}\"",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist crates/target crates/voided-wasm/pkg packages/enc-server/native/voided_node.node packages/enc-server/prebuilds/darwin-* packages/e2ee-client/wasm/init.js packages/e2ee-client/wasm/voided_wasm*"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.1",
    "jest": "^30.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "encryption",
    "e2ee",
    "privacy",
    "security",
    "compression",
    "wasm",
    "fused-shell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voided-network/voided.git"
  }
}
